# API Keys (provider 확장용 — 현재 팩토리 파이프라인에서는 미사용)
# 확장 지점: agents/content-factory/pipeline/lib/engine.ts
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Content Factory (default: Z.ai GLM-5.2) — 실제로 사용되는 provider 설정
ZAI_API_KEY=your_zai_api_key_here
FACTORY_LLM_PROVIDER=zai
ZAI_MODEL=glm-5.2
# 선택: ZAI_API_URL=https://api.z.ai/api/coding/paas/v4/chat/completions
# 선택: FACTORY_LLM_PROVIDER=codex

# Server Configuration
PORT=3001

# 쓰기 API(콘텐츠 생성·편집·삭제) 관리자 토큰
# NODE_ENV=production으로 공개 배포할 때는 필수. 미설정 시 쓰기 API가 503으로 비활성화된다.
# 브라우저에서 사용하려면 콘솔에서 한 번 등록:
#   localStorage.setItem('eduflix_admin_token', '<아래와 같은 값>')
# 예: openssl rand -hex 32
ADMIN_TOKEN=

# 공개 데모: 토큰 없이 콘텐츠 생성을 허용한다 (삭제·편집은 계속 ADMIN_TOKEN 필요).
# 기본값 true. IP당 1시간 3회, 전역 1시간 30회 레이트 리밋이 함께 적용된다.
# ⚠️ 자체 배포 시 방문자가 여러분의 LLM 키를 소모할 수 있으니, 운영자만 생성하게 하려면
#    false로 두고 ADMIN_TOKEN을 사용하세요.
ALLOW_PUBLIC_GENERATION=true

# 정적 배포(Vercel)에서 서버리스 생성 함수를 노출할지
# true면 팩토리 서버 없이도 /create 화면과 api/generate.ts 경로를 사용한다
VITE_SERVERLESS_GENERATION=false

# 교차 origin에서 API를 호출해야 할 때만 설정 (미설정 시 동일 origin만 허용)
# CORS_ORIGIN=https://eduflix.example.com
