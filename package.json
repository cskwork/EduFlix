{
  "name": "eduflix",
  "private": true,
  "version": "0.4.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "bun run server/index.ts",
    "dev:all": "bun run dev & bun run dev:server",
    "build": "vue-tsc -b && vite build",
    "start": "NODE_ENV=production bun run server/index.ts",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "factory": "bun agents/content-factory/pipeline/run.ts"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "pinia": "^3.0.4",
    "vue": "^3.5.24",
    "vue-router": "4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "bun-types": "^1.3.6",
    "esbuild": "^0.27.2",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.7.0",
    "happy-dom": "^20.3.7",
    "prettier": "^3.8.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.53.1",
    "vite": "^7.2.4",
    "vitest": "^4.0.18",
    "vue-tsc": "^3.1.4"
  }
}
